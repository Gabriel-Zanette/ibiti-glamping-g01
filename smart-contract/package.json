{
  "name": "ibitoken-smart-contract",
  "private": true,
  "version": "1.0.0",
  "description": "IBIToken — implementação ERC-20 (v1) da tokenização do IBITI Glamping · Inteli ADMD7 · Grupo G01",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "demo": "hardhat run scripts/demo-flow.ts",
