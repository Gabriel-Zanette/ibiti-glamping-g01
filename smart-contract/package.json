    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": ">=10.0.10",
    "@types/node": "^22.8.5",
    "chai": "^6.2.2",
    "ethers": "^6.14.0",
    "hardhat": "^3.15.0",
    "mocha": "^11.0.0",
    "typescript": "~6.0.3"
  }
}
