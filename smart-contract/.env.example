# Alternativa ao keystore do Hardhat (npx hardhat keystore set ...):
# exporte estas variáveis no shell antes de rodar comandos com --network sepolia.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<sua-chave>   # ou Alchemy/QuickNode/etc.
SEPOLIA_PRIVATE_KEY=0x<chave-privada-da-carteira-administrativa-de-teste>
ETHERSCAN_API_KEY=<opcional, para verificar o código no Etherscan>
