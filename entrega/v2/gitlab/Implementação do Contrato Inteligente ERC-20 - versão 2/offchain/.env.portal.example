# Copie para .env; gere IDENTITY_SECRET uma única vez e preserve-o com o banco.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_SECRET=
DATABASE_PATH=data/portal/ibiti.sqlite
DATABASE_SCOPE=ibiti-portal-academico-v1
PORT=3000
APP_ORIGIN=http://localhost:3000
CHAIN_ID=31337
# Feriados do calendário de atendimento, YYYY-MM-DD, separados por vírgula.
# Vazio considera apenas segunda a sexta; o responsável deve completar o calendário.
SERVICE_HOLIDAYS=
# Sem os três campos abaixo, cadastro e administração funcionam normalmente.
# Preencher juntos para habilitar vínculo financeiro, compra e cotas on-chain:
# RPC_URL=http://127.0.0.1:8545
# TOKEN_ADDRESS=
# START_BLOCK=
