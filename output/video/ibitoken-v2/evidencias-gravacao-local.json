  "steps": [
    {
      "title": "Emissão e preço de teste",
      "role": "ADMIN",
      "code": "deploy(150) → setPrimaryPrice(34.874,14 tBRL)",
      "note": "150 IBT indivisíveis. Reserva inicial de 50; teto de 20 por pessoa."
    },
    {
      "title": "Registrar os participantes",
      "role": "ADMIN",
      "code": "registerWallet(USER1, pessoa1) + registerWallet(USER2, pessoa2)",
      "note": "Pessoas diferentes; identificadores sintéticos. Nenhum documento pessoal é gravado."
    },
    {
      "title": "Registrar abertura simulada",
      "role": "ADMIN",
      "code": "recordOpening(15/03/2027, referência)",
      "note": "Data fictícia do ensaio. Oito semestres e quatro anos a partir deste marco."
    },
    {
      "title": "Autorizar o pagamento de USER1",
      "role": "USER1",
      "code": "tBRL.approve(IBIToken, 69.748,28)",
      "note": "Cada participante recebe moeda fictícia. A autorização cobre exatamente dois IBT."
    },
    {
      "title": "Comprar 2 IBT no início",
      "role": "USER1",
      "code": "buyPrimary(2, referência única)",
      "note": "Pagamento à tesouraria e entrega de IBT na mesma transação."
    },
    {
      "title": "Rejeitar compra sem cadastro",
      "role": "NÃO CADASTRADO",
      "code": "buyPrimary.staticCall(1, referência)",
      "note": "Uma simulação rejeitada não gera transação minerada nem cobrança de gas."
    },
    {
      "title": "Comprar 2 IBT na metade",
      "role": "USER2",
      "code": "avançar Anvil → approve → buyPrimary(2, referência)",
      "note": "Somente o relógio local avança. USER2 terá metade do tempo de USER1."
    },
    {
      "title": "Rejeitar transferência secundária",
      "role": "USER1",
      "code": "transfer.staticCall(USER2, 1)",
      "note": "Os dois estão cadastrados, mas transferências ordinárias estão desabilitadas."
    },
    {
      "title": "Impedir apuração antecipada",
      "role": "ADMIN",
      "code": "reportRevenue.staticCall(150.000 tBRL, relatório)",
      "note": "O semestre precisa terminar antes de ser apurado."
    },
    {
      "title": "Apurar e financiar o semestre 1",
      "role": "ADMIN",
      "code": "fechar semestre → approve(22.500) → reportRevenue(150.000)",
      "note": "15% da receita fictícia. Rateio por quantidade × tempo, incluindo a tesouraria."
    },
    {
      "title": "Sacar a parcela de USER1",
      "role": "USER1",
      "code": "claimRoyalty(1) → 300 tBRL",
      "note": "Dois IBT durante o semestre inteiro. Após o saque, o recebível fica zerado."
    },
    {
      "title": "Sacar a parcela de USER2",
      "role": "USER2",
      "code": "claimRoyalty(1) → 150 tBRL",
      "note": "Dois IBT durante metade do semestre. Mesma quantidade, menor tempo de posse."
    },
    {
      "title": "Anunciar recuperação de acesso",
      "role": "ADMIN",
      "code": "requestRecovery(USER1, carteira nova, protocolo)",
      "note": "Destino vazio, da mesma pessoa. Espera obrigatória de sete dias."
    },
    {
      "title": "Rejeitar execução antecipada",
      "role": "ADMIN",
      "code": "reissue.staticCall(USER1, carteira nova)",
      "note": "Antes do prazo, a movimentação definitiva é rejeitada."
    },
    {
      "title": "Cancelar e conferir estado final",
      "role": "ADMIN",
      "code": "cancelRecovery(USER1)",
      "note": "150 IBT; reserva de 50; USER1 e USER2 com 2 IBT; recebíveis sacados."
    }
